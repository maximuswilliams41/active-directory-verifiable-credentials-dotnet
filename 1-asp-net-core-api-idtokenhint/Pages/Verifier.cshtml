@page
@model AspNetCoreVerifiableCredentials.Pages.VerifierModel
@inject AyaRequestConfiguration Settings
@{ ViewData["Title"] = "Verify Aya Employee ID"; }
<section class="aya-intro"><p class="aya-eyebrow">CONTROLLED PILOT</p><h1>Verify an Aya Employee ID</h1>
<p>Present the credential from Microsoft Authenticator. A card image alone is not verification.</p></section>
<section class="aya-panel" id="aya-verification" data-ready="@((Settings.VerificationEnabled && Settings.Ready(false)).ToString().ToLowerInvariant())">
    <p id="verification-status" role="status" aria-live="polite">@(Settings.VerificationEnabled && Settings.Ready(false) ? "Ready to request an Aya credential." : "Verification is disabled or awaiting configuration.")</p>
    <button id="verify-credential" type="button" disabled="@(!Settings.VerificationEnabled || !Settings.Ready(false))">Verify credential</button>
    <button id="stop-verification" type="button" hidden>Stop waiting</button>
    <div id="verification-wallet" hidden><a id="verification-link" href="#">Open Microsoft Authenticator</a><div id="qrcode"></div></div>
    <p>Only Aya's approved issuer and credential type are accepted. This pilot does not establish a live offboarding-monitoring service.</p>
</section>
<form method="post" hidden>@Html.AntiForgeryToken()</form>
<script src="/qrcode.min.js"></script><script src="/aya-verification.js" defer></script>
